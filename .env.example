# ─────────────────────────────────────────────────────────────────────────────
# LOL 中东服玩家社区门户 (.env.example)
# ─────────────────────────────────────────────────────────────────────────────

# 应用运行端口 (生产环境 / PM2 使用)
PORT=3007

# 后台管理员鉴权配置
# 管理后台登录密码 (必须配置)
ADMIN_PASSWORD=your_admin_password_here

# JWT 签名密钥 (建议设置为 32 位以上随机字符串)
JWT_SECRET=your_jwt_secret_key_32bytes_random_string

# Cloudflare D1 数据库配置 (用于连接 HTTP API 代理)
# 登录 Cloudflare 控制台 -> 账户设置中获取 Account ID
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare 仪表盘 D1 数据库 UUID
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id

# Cloudflare API Token (具有 D1 编辑权限)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
